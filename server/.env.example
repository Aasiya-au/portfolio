# Copy this file to .env and fill it in. NEVER commit .env.

# ---- Chatbot (free key: https://aistudio.google.com/apikey) ----
GEMINI_API_KEY=
CHAT_MODEL=gemini-3.8-flash
EMBED_MODEL=gemini-embedding-001
MIN_SCORE=0.45
TOP_K=6
# THINKING_LEVEL=low

# ---- Contact form email (Gmail example) ----
# 1) Turn on 2-Step Verification for your Google account
# 2) Create an App Password: https://myaccount.google.com/apppasswords  (16 letters)
SMTP_USER=your.address@gmail.com
SMTP_PASS=
# Where messages should arrive (defaults to SMTP_USER)
CONTACT_TO=aasiya.asadullah@gmail.com
# Other providers: SMTP_HOST, SMTP_PORT, SMTP_SECURE=false (for port 587)
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465

# ---- Server ----
PORT=3001
ALLOWED_ORIGIN=http://localhost:5173
# Set to 1 when deployed behind a proxy/host so rate limiting sees real visitor IPs
# TRUST_PROXY=1

# ---- Analytics viewer: open /api/stats?token=THIS (leave empty to disable) ----
STATS_TOKEN=
